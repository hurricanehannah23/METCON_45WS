/* ---------- chart helper ---------- */
function setupCanvas(cv){const dpr=window.devicePixelRatio||1;const w=cv.clientWidth,h=+cv.getAttribute("height");cv.style.height=h+"px";cv.width=w*dpr;cv.height=h*dpr;const g=cv.getContext("2d");g.setTransform(dpr,0,0,dpr,0,0);g.font=`11px ${css("--f-mono")}`;return {g,w,h}}
function niceTicks(lo,hi,n=5){if(lo===hi){lo-=1;hi+=1}const span=hi-lo,step0=span/n,mag=10**Math.floor(Math.log10(step0)),step=[1,2,2.5,5,10].map(m=>m*mag).find(s=>s>=step0);const a=Math.floor(lo/step)*step,b=Math.ceil(hi/step)*step;const t=[];for(let v=a;v<=b+step/2;v+=step)t.push(+v.toFixed(6));return t}
/* panel: {top,height,series:[{pts:[[ms,v]],color,width,dash,bars}],yMin,yMax,label} */
function timeChart(cv,t0,t1,panels){
  const {g,w,h}=setupCanvas(cv);const L=44,R=10,X=ms=>L+(ms-t0)/(t1-t0)*(w-L-R);
  g.clearRect(0,0,w,h);
  const line=css("--line"),muted=css("--muted"),dim=css("--dim");
  // day separators & time labels at bottom
  const lastPanel=panels[panels.length-1];const axisY=lastPanel.top+lastPanel.height;
  const hrStep=(t1-t0)/3600e3>80?12:6;
  for(let t=Math.ceil(t0/3600e3/hrStep)*hrStep*3600e3;t<=t1;t+=hrStep*3600e3){const d=new Date(t),x=X(t);const lh=+d.toLocaleString("en-US",{timeZone:"America/New_York",hour:"numeric",hour12:false})%24;
    g.strokeStyle=lh===0?css("--line2"):line;g.lineWidth=lh===0?1.5:1;g.beginPath();g.moveTo(x,panels[0].top);g.lineTo(x,axisY);g.stroke();
    g.fillStyle=muted;g.textAlign="center";g.fillText(`${pad(d.getUTCHours())}Z`,x,axisY+13);
    if(lh===0||t===Math.ceil(t0/3600e3/hrStep)*hrStep*3600e3){g.fillStyle=dim;g.fillText(d.toLocaleDateString("en-US",{timeZone:"America/New_York",weekday:"short",day:"numeric"}),x,axisY+26)}}
  // now line
  const now=Date.now();if(now>t0&&now<t1){g.strokeStyle=css("--accent");g.setLineDash([3,3]);g.beginPath();g.moveTo(X(now),panels[0].top);g.lineTo(X(now),axisY);g.stroke();g.setLineDash([])}
  for(const p of panels){
    let vals=p.series.flatMap(s=>s.pts.map(q=>q[1])).filter(v=>v!=null);
    let lo=p.yMin??Math.min(...vals),hi=p.yMax??Math.max(...vals);if(!vals.length){lo=0;hi=1}
    const ticks=niceTicks(lo,hi,p.height>140?5:3);lo=p.yMin??ticks[0];hi=p.yMax??ticks[ticks.length-1];
    const Y=v=>p.top+p.height-(v-lo)/(hi-lo)*p.height;
    g.textAlign="right";
    for(const tv of ticks){if(tv<lo-1e-9||tv>hi+1e-9)continue;const y=Y(tv);g.strokeStyle=line;g.lineWidth=1;g.beginPath();g.moveTo(L,y);g.lineTo(w-R,y);g.stroke();g.fillStyle=muted;g.fillText(String(tv),L-6,y+4)}
    if(p.label){g.textAlign="left";g.fillStyle=css("--fg");g.fillText(p.label,L+4,p.top+12)}
    for(const s of p.series){const pts=s.pts.filter(q=>q[1]!=null&&q[0]>=t0&&q[0]<=t1);if(!pts.length)continue;
      g.strokeStyle=s.color;g.fillStyle=s.color;
      if(s.bars){const bw=Math.max(1,(w-L-R)/((t1-t0)/3600e3)*0.8);g.globalAlpha=s.alpha??0.55;for(const [t,v] of pts){const y=Y(v);g.fillRect(X(t)-bw/2,y,bw,Y(lo)-y)}g.globalAlpha=1;continue}
      if(s.area){g.globalAlpha=0.18;g.beginPath();g.moveTo(X(pts[0][0]),Y(lo));pts.forEach(([t,v])=>g.lineTo(X(t),Y(v)));g.lineTo(X(pts[pts.length-1][0]),Y(lo));g.closePath();g.fill();g.globalAlpha=1}
      g.lineWidth=s.width||2;g.setLineDash(s.dash||[]);g.beginPath();pts.forEach(([t,v],i)=>i?g.lineTo(X(t),Y(v)):g.moveTo(X(t),Y(v)));g.stroke();g.setLineDash([]);
      if(s.thresholds)for(const [tv,col] of s.thresholds){if(tv>hi)continue;g.strokeStyle=col;g.setLineDash([6,4]);g.lineWidth=1;g.beginPath();g.moveTo(L,Y(tv));g.lineTo(w-R,Y(tv));g.stroke();g.setLineDash([])}
    }
  }
}

