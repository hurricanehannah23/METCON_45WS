  try{const pt=await getJSON(`https://api.weather.gov/points/${CAPE.lat},${CAPE.lon}`);const grid=await getJSON(pt.properties.forecastGridData);const p=grid.properties;
    const kmh=p.windSpeed?.uom?.includes("km_h")!==false;
    mg={T:expandGrid(p.temperature,c2f),D:expandGrid(p.dewpoint,c2f),W:expandGrid(p.windSpeed,v=>kmh?v*0.539957:v),G:expandGrid(p.windGust,v=>kmh?v*0.539957:v),
        P:expandGrid(p.probabilityOfPrecipitation,v=>v),S:expandGrid(p.skyCover,v=>v),upd:new Date(p.updateTime)};
    $("#mgMeta").textContent=`${pt.properties.gridId} ${pt.properties.gridX},${pt.properties.gridY} · grid updated ${fmtZ(mg.upd)}`;drawMeteogram();
  }catch(e){$("#mgMeta").textContent=`Couldn't load the NWS grid: ${e.message}`}
}
