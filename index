function setCycle(on){clearInterval(wbTimer);wbTimer=null;$("#wbCycle").checked=on;if(on)wbTimer=setInterval(()=>stepTab(1),(+$("#wbSecs").value)*1000)}
function setWall(on){document.body.classList.toggle("wall",on);$("#btnWall").setAttribute("aria-pressed",String(on));window.scrollTo(0,0);
  if(on){try{document.documentElement.requestFullscreen?.().catch(()=>{})}catch{}}else{setCycle(false);if(document.fullscreenElement){try{document.exitFullscreen()}catch{}}}
  renderWallBar();setTimeout(()=>{drawMeteogram()},80)}
function renderWallBar(){if(!document.body.classList.contains("wall"))return;const d=new Date();
  $("#wbZ").textContent=`${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:${pad(d.getUTCSeconds())}`;$("#wbL").textContent=fmtLT(d);
  const i=NAV.findIndex(t=>t[0]===curTab());$("#wbTab").textContent=`${pad(i+1)} · ${NAV[i][1]}`}
setInterval(renderWallBar,1000);
$("#btnWall").onclick=()=>setWall(!document.body.classList.contains("wall"));
$("#wbExit").onclick=()=>setWall(false);
$("#wbPrev").onclick=()=>stepTab(-1);$("#wbNext").onclick=()=>stepTab(1);
$("#wbCycle").onchange=()=>setCycle($("#wbCycle").checked);$("#wbSecs").onchange=()=>{if($("#wbCycle").checked)setCycle(true)};
document.addEventListener("fullscreenchange",()=>{if(!document.fullscreenElement&&document.body.classList.contains("wall")){/* stay in wall layout; Esc again or the button exits */}});
document.addEventListener("keydown",e=>{if(!document.body.classList.contains("wall"))return;if(/INPUT|SELECT|TEXTAREA/.test(document.activeElement?.tagName))return;
  if(e.key==="Escape")setWall(false);else if(e.key==="PageDown"||e.key===" "&&!e.shiftKey){e.preventDefault();stepTab(1)}else if(e.key==="PageUp"){e.preventDefault();stepTab(-1)}});


const hashTab=(location.hash||"").slice(1);const start=(hashTab&&hashTab!=="wall"?hashTab:"")||store.get("tab","launch");
show(start,false);
if(location.hash==="#wall")setWall(true);
// warm the briefing-critical tabs in the background
["launch","obs"].forEach(t=>{if(!loaded[t]){loaded[t]=true;loaders[t]()}});
})();
</script>
</body>
</html>
