<script>
(() => {
"use strict";
const NAV=[["launch","Launch Schedule"],["obs","Past 24 h"],["impacts","Impacts"],["analysis","Model Analysis"],["skewt","Skew-T"],["guidance","Prog Charts"],["models","Windy"],["pivotal","Pivotal Weather"],["meteogram","Meteogram"],["spc","SPC Outlook"],["planning","Planning Forecast","https://45thweathersquadron.nebula.spaceforce.mil/pages/planningAndAviationForecastProducts.html"],["refs","References"]];
const TABS=NAV.filter(t=>!t[2]);
const CAPE={lat:28.4884,lon:-80.5778};
const STATIONS=[{id:"KTTS",name:"KSC",full:"Shuttle Landing Facility"},{id:"KXMR",name:"Cape",full:"Cape Canaveral SFS"},{id:"KCOF",name:"Patrick SFB",full:"Patrick SFB"}];
const $=s=>document.querySelector(s);
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const store={get(k,d){try{const v=localStorage.getItem("metcon:"+k);return v==null?d:JSON.parse(v)}catch{return d}},set(k,v){try{localStorage.setItem("metcon:"+k,JSON.stringify(v))}catch{}}};
const css=n=>getComputedStyle(document.documentElement).getPropertyValue(n).trim();
const pad=n=>String(n).padStart(2,"0");
const fmtZ=d=>`${pad(d.getUTCDate())}/${pad(d.getUTCHours())}${pad(d.getUTCMinutes())}Z`;
const fmtL=d=>d.toLocaleString("en-US",{timeZone:"America/New_York",weekday:"short",month:"short",day:"numeric",hour:"2-digit",minute:"2-digit",hour12:false});
const fmtLT=d=>d.toLocaleTimeString("en-US",{timeZone:"America/New_York",hour:"2-digit",minute:"2-digit",hour12:false});
const stamp=()=>`updated ${fmtZ(new Date())}`;
async function getJSON(url,opt={}){const r=await fetch(url,{headers:{Accept:opt.accept||"application/geo+json, application/json"},cache:"no-store"});if(!r.ok)throw new Error(`${r.status} ${r.statusText}`);return r.json()}
const kmh2kt=v=>v==null?null:v*0.539957, c2f=v=>v==null?null:v*9/5+32, mm2in=v=>v==null?null:v/25.4;

/* ---------- clock ---------- */
function tick(){const d=new Date();$("#clkZ").textContent=`${pad(d.getUTCHours())}${pad(d.getUTCMinutes())}`;$("#clkL").textContent=fmtLT(d)}
tick();setInterval(tick,15000);

/* ---------- tabs ---------- */
const loaded={};
const loaders={};
const nav=$("#tabs");
NAV.forEach(([id,label,href],i)=>{
  if(href){const a=document.createElement("a");a.className="tab ext";a.href=href;a.target="_blank";a.rel="noopener";a.title="Opens in a new tab";a.innerHTML=`<span class="n">${pad(i+1)}</span>${label} <span aria-hidden="true">↗</span>`;nav.appendChild(a);return}
  const b=document.createElement("button");b.className="tab";b.type="button";b.role="tab";b.id="t-"+id;b.setAttribute("aria-controls","v-"+id);b.innerHTML=`<span class="n">${pad(i+1)}</span>${label}`;b.onclick=()=>show(id,true);nav.appendChild(b)});
function show(id,push){
  if(!TABS.some(t=>t[0]===id))id="launch";
  TABS.forEach(([t])=>{$("#v-"+t).hidden=t!==id;$("#t-"+t).setAttribute("aria-selected",t===id)});
  $("#t-"+id).scrollIntoView({block:"nearest",inline:"nearest"});
  if(push){try{history.replaceState(null,"","#"+id)}catch{} store.set("tab",id)}
  if(!loaded[id]&&loaders[id]){loaded[id]=true;loaders[id]()}
  else if(id==="meteogram")drawMeteogram();
}
nav.addEventListener("keydown",e=>{if(!/Arrow(Left|Right)/.test(e.key))return;const ids=TABS.map(t=>t[0]);const cur=ids.findIndex(t=>$("#t-"+t).getAttribute("aria-selected")==="true");const n=ids[(cur+(e.key==="ArrowRight"?1:-1)+ids.length)%ids.length];show(n,true);$("#t-"+n).focus()});

/* ---------- image helper ---------- */
function imgCell(title,src,href){
  const cell=document.createElement("div");cell.className="imgcell";
  cell.innerHTML=`<div class="cap"><b>${esc(title)}</b><a href="${esc(href||src)}" target="_blank" rel="noopener">open</a></div><div class="imgbox"></div>`;
  setImg(cell.querySelector(".imgbox"),src,href);return cell;
}
function setImg(box,src,href){
  box.innerHTML="";const img=new Image();img.alt="";img.loading="lazy";img.decoding="async";
  img.src=src+(src.includes("?")?"&":"?")+"_="+Math.floor(Date.now()/60000);
  img.onerror=()=>{box.innerHTML=`<div class="fail">Image not available yet<a href="${esc(href||src)}" target="_blank" rel="noopener">Open the product page</a></div>`};
  box.appendChild(img);
}

/* ---------- 1 launch schedule ---------- */
const LL_URLS=["https://ll.thespacedevs.com/2.3.0/launches/upcoming/?location__ids=12,27&limit=20&mode=normal","https://ll.thespacedevs.com/2.2.0/launch/upcoming/?location__ids=12,27&limit=20&mode=normal"];
let llData=[];
async function loadLaunches(force){
  $("#llMeta").textContent="loading…";
  const cache=store.get("ll",null);
  if(!force&&cache&&Date.now()-cache.t<30*60e3){llData=cache.d;renderLaunches(`cached ${fmtZ(new Date(cache.t))}`);return}
  let err;
  for(const u of LL_URLS){try{const j=await getJSON(u,{accept:"application/json"});llData=(j.results||[]).map(r=>({
      net:r.net,ws:r.window_start,we:r.window_end,veh:r.rocket?.configuration?.name||r.rocket?.configuration?.full_name||"",
      mis:r.mission?.name||r.name,orbit:r.mission?.orbit?.abbrev||"",pad:r.pad?.name||"",prov:r.launch_service_provider?.name||"",
      st:r.status?.abbrev||"",stn:r.status?.name||""}));
      store.set("ll",{t:Date.now(),d:llData});renderLaunches(stamp());return}catch(e){err=e}}
  if(cache){llData=cache.d;renderLaunches(`feed unavailable (${err.message}); showing cache from ${fmtZ(new Date(cache.t))}`)}
  else{llData=[];renderLaunches(`feed unavailable: ${err.message}`)}
}
function statusPill(st,stn){const s=(st||"").toUpperCase();const cls=s==="GO"?"ok":s==="HOLD"||s==="FAILURE"?"crit":s==="TBC"?"warn":s==="IN FLIGHT"||s==="SUCCESS"?"info":"";return `<span class="pill ${cls}" title="${esc(stn)}">${esc(st||"—")}</span>`}
function renderLaunches(meta){
  $("#llMeta").textContent=meta;
  const manual=store.get("manual",[]).map((m,i)=>({...m,manual:true,idx:i}));
  const now=Date.now()-6*3600e3;
  const rows=[...llData,...manual].filter(r=>new Date(r.net).getTime()>now).sort((a,b)=>new Date(a.net)-new Date(b.net));
  const tb=$("#llBody");
  if(!rows.length){tb.innerHTML=`<tr><td colspan="8" class="empty">No upcoming launches listed. Add operations below.</td></tr>`;$("#nextLaunch").innerHTML="";return}
  tb.innerHTML=rows.map(r=>{const d=new Date(r.net);let win=r.note||"";
    if(!r.manual&&r.ws&&r.we){const a=new Date(r.ws),b=new Date(r.we);const mins=Math.round((b-a)/60000);win=mins<=0?"instantaneous":`${fmtLT(a)}–${fmtLT(b)} ET (${mins>=60?(mins/60).toFixed(mins%60?1:0)+" h":mins+" min"})`}
    return `<tr class="${r.manual?"manual":""}"><td class="m">${fmtZ(d)}</td><td class="m">${esc(fmtL(d))}</td><td>${esc(r.veh)}${r.prov?`<div class="src">${esc(r.prov)}</div>`:""}</td><td class="wrap">${esc(r.mis)}${r.orbit?` <span class="src">${esc(r.orbit)}</span>`:""}</td><td>${esc(r.pad)}</td><td class="m">${esc(win)}</td><td>${r.manual?'<span class="pill">LOCAL</span>':statusPill(r.st,r.stn)}</td><td>${r.manual?`<button class="del" type="button" data-i="${r.idx}" aria-label="Remove">Remove</button>`:""}</td></tr>`}).join("");
  const n=rows.find(r=>new Date(r.net).getTime()>Date.now());
  if(n){const d=new Date(n.net);$("#nextLaunch").innerHTML=`<div class="next"><span class="k">Next</span><span class="t">${esc(n.veh)} · ${esc(n.mis)}</span><span class="mono">${esc(n.pad)} · ${fmtZ(d)} / ${esc(fmtL(d))} ET</span><span class="c" id="countdown"></span></div>`;nextAt=d.getTime();cd()}
}
let nextAt=0;function cd(){const el=$("#countdown");if(!el||!nextAt)return;let s=Math.max(0,Math.round((nextAt-Date.now())/1000));const d=Math.floor(s/86400);s%=86400;el.textContent=`T−${d?d+"d ":""}${pad(Math.floor(s/3600))}:${pad(Math.floor(s%3600/60))}:${pad(s%60)}`}
setInterval(cd,1000);
$("#llBody").addEventListener("click",e=>{const b=e.target.closest(".del");if(!b)return;const m=store.get("manual",[]);m.splice(+b.dataset.i,1);store.set("manual",m);renderLaunches($("#llMeta").textContent)});
$("#addForm").addEventListener("submit",e=>{e.preventDefault();const v=$("#fNet").value;if(!v)return;
  const d=etLocalToDate(v);const m=store.get("manual",[]);m.push({net:d.toISOString(),veh:$("#fVeh").value.trim(),mis:$("#fMis").value.trim(),pad:$("#fPad").value.trim(),note:$("#fNote").value.trim()});store.set("manual",m);e.target.reset();renderLaunches($("#llMeta").textContent)});
function etLocalToDate(v){ // interpret datetime-local as America/New_York
  const guess=new Date(v+"Z");const off=etOffsetMin(guess);return new Date(guess.getTime()-off*60000)}
function etOffsetMin(d){const p=new Intl.DateTimeFormat("en-US",{timeZone:"America/New_York",hourCycle:"h23",year:"numeric",month:"2-digit",day:"2-digit",hour:"2-digit",minute:"2-digit"}).formatToParts(d).reduce((a,x)=>(a[x.type]=x.value,a),{});
  return (Date.UTC(+p.year,+p.month-1,+p.day,+p.hour,+p.minute)-Math.floor(d.getTime()/60000)*60000)/60000}
loaders.launch=()=>loadLaunches(false);
$("#llRefresh").onclick=()=>loadLaunches(true);

/* ---------- 2 past 24 h ---------- */
let obsResults={};
async function loadObs(){
  $("#obsMeta").textContent="loading…";
  const end=new Date(),start=new Date(end-24*3600e3);
  $("#stations").innerHTML=STATIONS.map(s=>`<section class="panel stn" id="stn-${s.id}"><div class="ph"><h3>${s.name}<small>${s.id}</small></h3><span class="meta">${s.full}</span></div><div class="pb"><div class="empty">Loading observations…</div></div></section>`).join("");
  await Promise.all(STATIONS.map(async s=>{
    try{const j=await getJSON(`https://api.weather.gov/stations/${s.id}/observations?start=${start.toISOString()}&end=${end.toISOString()}`);
      obsResults[s.id]=summarize(j.features.map(f=>f.properties))}catch(e){obsResults[s.id]={error:e.message}}
    renderStation(s)}));
  renderObsSummary();
  $("#obsMeta").textContent=`${fmtZ(start)} – ${fmtZ(end)} · ${stamp()}`;
}
function summarize(obs){
  const r={n:obs.length,maxT:null,minT:null,maxW:null,maxG:null,precip:null,ltg:false,ltgObs:[],tmax:null,tmin:null,tw:null};
  const hourly={};
  for(const o of obs){const t=new Date(o.timestamp);const T=c2f(o.temperature?.value);
    if(T!=null){if(r.maxT==null||T>r.maxT){r.maxT=T;r.tmax=t}if(r.minT==null||T<r.minT){r.minT=T;r.tmin=t}}
    const W=kmh2kt(o.windSpeed?.value),G=kmh2kt(o.windGust?.value);
    if(W!=null&&(r.maxW==null||W>r.maxW)){r.maxW=W;r.tw=t;r.wd=o.windDirection?.value}
    if(G!=null&&(r.maxG==null||G>r.maxG)){r.maxG=G;r.tg=t}
    const P=o.precipitationLastHour?.value;
    if(P!=null){const k=t.toISOString().slice(0,13);if(!hourly[k]||t>hourly[k].t)hourly[k]={t,v:P}}
    const raw=(o.rawMessage||"")+" "+(o.presentWeather||[]).map(w=>w.rawString||"").join(" ");
    if(/\bTS|VCTS|\bLTG|TSB\d|TSE\d/.test(raw.replace(/^\S+\s+\S+/,"").replace(/\bTSNO\b/g,""))){r.ltg=true;r.ltgObs.push(t)}
  }
  const hv=Object.values(hourly);if(hv.length)r.precip=mm2in(hv.reduce((a,b)=>a+b.v,0));
  return r;
}
function renderStation(s){
  const box=$(`#stn-${s.id} .pb`),r=obsResults[s.id];
  if(r.error){box.innerHTML=`<div class="empty err">Couldn't load ${s.id}: ${esc(r.error)}</div>`;return}
  if(!r.n){box.innerHTML=`<div class="empty">No observations from ${s.id} in the last 24 h.</div>`;return}
  const f=(v,d=0)=>v==null?"—":v.toFixed(d);const when=t=>t?fmtZ(t):"";
  const ov=store.get("ltg:"+s.id+":"+new Date().toISOString().slice(0,10),"auto");
  const yes=ov==="yes"||(ov==="auto"&&r.ltg);
  const ltgDetail=ov!=="auto"?"Set by forecaster":r.ltg?`TS/LTG in ${r.ltgObs.length} ob${r.ltgObs.length>1?"s":""}, last ${fmtZ(r.ltgObs.sort((a,b)=>b-a)[0])}`:"No TS/LTG in METARs";
  const dirs=["N","NNE","NE","ENE","E","ESE","SE","SSE","S","SSW","SW","WSW","W","WNW","NW","NNW"];
  const wd=r.wd==null?"":dirs[Math.round(r.wd/22.5)%16]+" ";
  box.innerHTML=`<div class="kvs">
    <div class="kv"><span>Max temp</span><b>${f(r.maxT)}<small>°F</small></b><i>${when(r.tmax)}</i></div>
    <div class="kv"><span>Min temp</span><b>${f(r.minT)}<small>°F</small></b><i>${when(r.tmin)}</i></div>
    <div class="kv"><span>Max wind / gust</span><b>${f(r.maxW)}${r.maxG!=null?"G"+f(r.maxG):""}<small>kt</small></b><i>${wd}${when(r.tg||r.tw)}</i></div>
    <div class="kv"><span>Precip</span><b>${r.precip==null?"—":r.precip<0.005&&r.precip>0?"T":r.precip.toFixed(2)}<small>${r.precip==null?"":"in"}</small></b><i>${r.n} obs</i></div>
    <div class="ltg ${yes?"yes":""}"><span class="t">${yes?"LIGHTNING":"NO LIGHTNING"}</span><span class="d">${esc(ltgDetail)}</span>
      <select aria-label="Lightning for ${s.name}" data-s="${s.id}"><option value="auto"${ov==="auto"?" selected":""}>Auto</option><option value="yes"${ov==="yes"?" selected":""}>Yes</option><option value="no"${ov==="no"?" selected":""}>No</option></select></div></div>`;
}
$("#stations").addEventListener("change",e=>{const sel=e.target.closest("select[data-s]");if(!sel)return;store.set("ltg:"+sel.dataset.s+":"+new Date().toISOString().slice(0,10),sel.value);renderStation(STATIONS.find(s=>s.id===sel.dataset.s));renderObsSummary()});
function renderObsSummary(){
  const ok=STATIONS.map(s=>({s,r:obsResults[s.id]})).filter(x=>x.r&&!x.r.error&&x.r.n);
  if(!ok.length){$("#obsSummary").innerHTML="";return}
  const best=(k,fn)=>ok.filter(x=>x.r[k]!=null).sort((a,b)=>fn(a.r[k],b.r[k]))[0];
  const hi=best("maxT",(a,b)=>b-a),lo=best("minT",(a,b)=>a-b),pr=best("precip",(a,b)=>b-a);
  const wn=ok.map(x=>({...x,v:Math.max(x.r.maxW??-1,x.r.maxG??-1)})).sort((a,b)=>b.v-a.v)[0];
  const ltg=ok.filter(x=>{const ov=store.get("ltg:"+x.s.id+":"+new Date().toISOString().slice(0,10),"auto");return ov==="yes"||(ov==="auto"&&x.r.ltg)}).map(x=>x.s.name);
  const c=(lab,val,who)=>`<div class="sum"><span>${lab}</span><b>${val}</b>${who?`<em>${who}</em>`:""}</div>`;
  $("#obsSummary").innerHTML=
    c("Highest precip",pr?pr.r.precip.toFixed(2)+" in":"—",pr?.s.name)+
    c("Peak wind",wn&&wn.v>=0?wn.v.toFixed(0)+" kt":"—",wn?.s.name)+
