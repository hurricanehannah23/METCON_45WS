<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>Metcon Briefing</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Condensed:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap">
<style>
/* Layout: ops console matching the 45 WS dashboard. Sticky header + tab rail, one panel per Metcon briefing item, in briefing order. */
:root{
  --bg:#0b1114; --panel:#121a1e; --raised:#1a252b; --line:#222e35; --line2:#2d3b43;
  --fg:#d8e2e7; --muted:#81919a; --dim:#56656e;
  --accent:#e9a23b; --ok:#3bc98a; --warn:#f0c24a; --strong:#ff8a3d; --crit:#ff5161; --info:#6cb6ff;
  --s1:#e9a23b; --s2:#6cb6ff; --s3:#3bc98a; --s4:#c58cff; --s5:#ff7aa8;
  --f-ui:"IBM Plex Sans Condensed","Roboto Condensed","Arial Narrow",system-ui,sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Consolas,monospace;
  color-scheme:dark;
}
/* Light board: a paper-white console for bright briefing rooms */
:root.light{
  --bg:#eef2f4; --panel:#ffffff; --raised:#f4f7f8; --line:#d6dee2; --line2:#bfcbd1;
  --fg:#13212a; --muted:#52646e; --dim:#7b8b94;
  --accent:#b8690a; --ok:#14865a; --warn:#e2aa16; --strong:#d05e14; --crit:#cf2c3d; --info:#1d6cc0;
  --s1:#c47a0c; --s2:#1d6cc0; --s3:#14865a; --s4:#7d45c9; --s5:#c63a72;
  color-scheme:light;
}
*{box-sizing:border-box}
html,body{margin:0}
body{background:var(--bg);color:var(--fg);font:14px/1.45 var(--f-ui);padding-left:max(14px,env(safe-area-inset-left,0px));padding-right:max(14px,env(safe-area-inset-right,0px));padding-bottom:max(28px,env(safe-area-inset-bottom,0px))}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:30;background:var(--bg)}
button,input,select,textarea{font:inherit;color:inherit}
a{color:var(--info)}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
[hidden]{display:none!important}

header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.hrow{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;padding:10px 0 8px}
.brand{display:flex;align-items:baseline;gap:10px;margin-right:auto;min-width:0}
.brand h1{margin:0;font-size:21px;font-weight:700;letter-spacing:.01em}
.brand .sub{color:var(--muted);font-size:12px;letter-spacing:.08em;text-transform:uppercase}
.clock{display:flex;gap:14px;font-family:var(--f-mono);font-size:13px}
.clock b{color:var(--muted);font-weight:500;margin-right:5px;font-size:11px}
.btn{background:var(--panel);border:1px solid var(--line);border-radius:4px;padding:6px 11px;cursor:pointer;font-weight:500}
.btn:hover{border-color:var(--muted)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:#1a1206;font-weight:600}
.btn.sm{padding:3px 9px;font-size:12px}
.btn:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.tab:focus-visible{outline:2px solid var(--accent);outline-offset:1px}

nav.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:thin;margin:0 -2px}
.tab{flex:none;background:none;border:0;border-bottom:3px solid transparent;padding:8px 11px 7px;cursor:pointer;color:var(--muted);font-weight:600;font-size:13px;letter-spacing:.04em;white-space:nowrap}
.tab .n{font-family:var(--f-mono);font-size:10px;color:var(--dim);margin-right:6px}
.tab:hover{color:var(--fg)}
a.tab{text-decoration:none;display:inline-block}
.tab.ext{color:var(--info)}
.pvform{display:grid;gap:10px 12px;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));align-items:end}
.pvform label{display:flex;flex-direction:column;gap:4px;font-size:11px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
.pvform select,.pvform input{width:100%}
.pvform .btn{text-align:center;text-decoration:none;padding:8px 12px}
.tab[aria-selected="true"]{color:var(--fg);border-bottom-color:var(--accent)}
.tab[aria-selected="true"] .n{color:var(--accent)}

main{padding-top:14px}
.view{display:grid;gap:14px}
.vh{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 14px}
.vh h2{margin:0;font-size:18px;font-weight:700;letter-spacing:.02em;text-wrap:balance}
.vh .meta{color:var(--muted);font-size:12px;font-family:var(--f-mono)}
.vh .act{margin-left:auto;display:flex;gap:8px;flex-wrap:wrap;align-items:center}

section.panel{background:var(--panel);border:1px solid var(--line);border-radius:4px;min-width:0;display:flex;flex-direction:column}
.ph{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px;padding:9px 12px;border-bottom:1px solid var(--line)}
.ph h3{margin:0;font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;margin-right:auto}
.ph .meta{color:var(--muted);font-size:12px}
.pb{padding:12px;min-width:0}
.grid2{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr))}
.grid3{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr))}

.tablewrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;font-size:13px}
th,td{padding:7px 9px;text-align:left;border-bottom:1px solid var(--line);white-space:nowrap}
th{font-weight:600;color:var(--muted);font-size:11px;letter-spacing:.08em;text-transform:uppercase;background:var(--panel)}
td.num,th.num{text-align:right}
td{font-variant-numeric:tabular-nums}
td.m{font-family:var(--f-mono);font-size:12.5px}
td.wrap{white-space:normal;min-width:180px}
tr:last-child td{border-bottom:0}
.empty{color:var(--muted);padding:18px 12px;text-align:center;font-size:13px}
.err{color:var(--crit)}

.pill{display:inline-block;font-family:var(--f-mono);font-size:11px;font-weight:600;letter-spacing:.05em;padding:2px 7px;border-radius:2px;border:1px solid var(--line2);color:var(--muted)}
.pill.ok{color:var(--ok);border-color:color-mix(in srgb,var(--ok) 50%,transparent)}
.pill.warn{color:#1c1503;background:var(--warn);border-color:var(--warn)}
.pill.crit{color:#fff;background:var(--crit);border-color:var(--crit)}
.pill.info{color:var(--info);border-color:color-mix(in srgb,var(--info) 50%,transparent)}
.src{font-size:11px;color:var(--dim);font-family:var(--f-mono)}

/* Past 24 h station cards */
.stations{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}
.stn .ph h3 small{font-family:var(--f-mono);color:var(--muted);font-weight:500;letter-spacing:.04em;margin-left:6px}
.kvs{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.kv{padding:9px 10px;border:1px solid var(--line);border-radius:3px;background:var(--bg);display:flex;flex-direction:column;gap:2px;min-width:0}
.kv span{color:var(--muted);font-size:11px;letter-spacing:.06em;text-transform:uppercase}
.kv b{font-family:var(--f-mono);font-size:22px;font-weight:500;font-variant-numeric:tabular-nums;line-height:1.15}
.kv b small{font-size:12px;color:var(--muted);font-weight:400;margin-left:2px}
.kv i{font-style:normal;color:var(--dim);font-size:11px;font-family:var(--f-mono)}
.ltg{grid-column:1/-1;display:flex;align-items:center;gap:10px;padding:9px 10px;border:1px solid var(--line);border-left:6px solid var(--ok);border-radius:3px;background:var(--bg)}
.ltg.yes{border-left-color:var(--crit);background:color-mix(in srgb,var(--crit) 10%,var(--bg))}
.ltg .t{font-weight:700;letter-spacing:.04em}
.ltg .d{color:var(--muted);font-size:12px;margin-right:auto}
.ltg select{background:var(--panel);border:1px solid var(--line);border-radius:3px;padding:3px 6px;font-size:12px}
.sumrow{display:flex;flex-wrap:wrap;gap:8px}
.sum{flex:1 1 150px;padding:9px 12px;border:1px solid var(--line);border-radius:3px;background:var(--panel)}
.sum span{display:block;color:var(--muted);font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.sum b{font-family:var(--f-mono);font-size:20px;font-weight:500}
.sum em{font-style:normal;color:var(--muted);font-size:12px;margin-left:6px}

/* Product imagery */
.imgcell{display:flex;flex-direction:column;min-width:0}
.imgcell .cap{display:flex;justify-content:space-between;gap:8px;padding:7px 10px;font-size:12px;color:var(--muted);border-bottom:1px solid var(--line)}
.imgcell .cap b{color:var(--fg);font-weight:600;letter-spacing:.06em;text-transform:uppercase;font-size:11px}
.imgbox{position:relative;background:#fff;display:flex;align-items:center;justify-content:center;min-height:200px}
.imgbox img{display:block;width:100%;height:auto;max-width:100%}
.imgbox .fail{position:absolute;inset:0;display:flex;flex-direction:column;gap:6px;align-items:center;justify-content:center;background:var(--bg);color:var(--muted);font-size:13px;text-align:center;padding:16px}
.quad{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:1px;background:var(--line)}
.quad .imgcell{background:var(--panel)}

.ctrl{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center;font-size:12px;color:var(--muted)}
.ctrl label{display:inline-flex;align-items:center;gap:6px}
select,input[type=text],input[type=url],input[type=datetime-local],textarea{background:var(--bg);border:1px solid var(--line);border-radius:3px;padding:5px 8px;font-size:13px}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:4px;overflow:hidden}
.seg button{background:none;border:0;padding:4px 10px;cursor:pointer;color:var(--muted);font-size:12px}
.seg button.on{background:var(--line2);color:var(--fg)}

/* AFD */
.imp textarea{display:block;width:100%;min-height:calc(100vh - 230px);min-height:calc(100dvh - 230px);resize:vertical;border:0;border-radius:4px;background:var(--panel);color:var(--fg);padding:20px 24px;font:500 28px/1.45 var(--f-ui);letter-spacing:.005em}
.imp textarea::placeholder{color:var(--dim)}
.imp textarea:focus-visible{outline:2px solid var(--accent);outline-offset:-2px}
.impconfirm{display:flex;flex-wrap:wrap;gap:8px;align-items:center;padding:8px 12px;border:1px solid var(--crit);border-radius:4px;background:var(--panel)}
.afdnav{display:flex;flex-wrap:wrap;gap:6px}

canvas.chart{width:100%;display:block}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:6px}
.sw{display:inline-block;width:14px;height:3px;border-radius:2px}

.mdbar{display:flex;flex-wrap:wrap;gap:8px 12px;align-items:center}
.mdl{color:var(--muted);font-size:11px;letter-spacing:.08em;text-transform:uppercase;min-width:4.5em}
.seg.wrap{flex-wrap:wrap}
.windy{overflow:hidden}
.windy iframe{display:block;width:100%;height:min(72vh,720px);min-height:420px;border:0}
.seg button:disabled{opacity:.35;cursor:not-allowed}
.hbtns{display:flex;gap:8px;flex-wrap:wrap}
/* wall mode: header hidden, current briefing item fills the screen, floating control bar */
.wallbar{display:none}
body.wall{font-size:16px;padding-top:max(64px,env(safe-area-inset-top,0px))}
body.wall header{display:none}
body.wall .wallbar{display:flex;flex-wrap:wrap;position:fixed;z-index:40;top:max(10px,env(safe-area-inset-top,0px));right:max(10px,env(safe-area-inset-right,0px));left:max(10px,env(safe-area-inset-left,0px));justify-content:flex-end;align-items:center;gap:8px;padding:6px 8px 6px 12px;border-radius:10px;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(6px);border:1px solid var(--line)}
.wbclock{font:600 15px var(--f-mono);font-variant-numeric:tabular-nums} .wbclock b{color:var(--muted);font-size:11px;margin-right:6px}
.wbtab{font-weight:700;letter-spacing:.04em;min-width:10ch;text-align:center;margin-right:auto;order:-1;font-size:18px}
.wbcyc{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted)}
.wbcyc select{padding:2px 4px;font-size:12px}
body.wall main{padding-top:0}
body.wall .vh h2{font-size:26px}
body.wall .vh .meta{font-size:14px}
body.wall table{font-size:16px}
body.wall th{font-size:13px}
body.wall .kv b{font-size:30px} body.wall .kv span{font-size:13px}
body.wall .sum b{font-size:28px} body.wall .sum span{font-size:13px}
body.wall .ltg .t{font-size:18px}
body.wall .next .t,body.wall .next .c{font-size:26px}
body.wall .imp textarea{font-size:36px;min-height:calc(100vh - 170px);min-height:calc(100dvh - 170px)}
body.wall #impClear{display:none}
body.wall .windy iframe{height:calc(100vh - 230px);height:calc(100dvh - 230px)}
body.wall .note,body.wall form.add,body.wall .del{display:none}
body.wall section.panel:has(#addForm){display:none}
/* prog charts: fit the whole chart on screen so hours can be clicked through without scrolling */
#pgBox{min-height:0;background:var(--panel)}
#pgBox img{width:auto;max-width:100%;max-height:calc(100vh - 290px);max-height:calc(100dvh - 290px);min-height:300px;object-fit:contain;margin:0 auto}
body.wall #pgBox img{max-height:calc(100vh - 220px);max-height:calc(100dvh - 220px)}
#v-guidance .note{display:none}
/* Launch form */
form.add{display:grid;gap:8px;grid-template-columns:repeat(auto-fit,minmax(min(100%,160px),1fr));align-items:end}
form.add label{display:flex;flex-direction:column;gap:3px;font-size:11px;color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
form.add input{width:100%}
.del{background:none;border:0;color:var(--dim);cursor:pointer;font-size:12px}
.del:hover{color:var(--crit)}
tr.manual td:first-child{box-shadow:inset 3px 0 0 var(--accent)}
.next{display:flex;flex-wrap:wrap;gap:6px 18px;align-items:baseline;padding:12px 14px;border:1px solid var(--line);border-left:6px solid var(--accent);border-radius:4px;background:var(--panel)}
.next .k{color:var(--muted);font-size:11px;letter-spacing:.1em;text-transform:uppercase}
.next .t{font-size:18px;font-weight:700}
.next .c{font-family:var(--f-mono);font-size:18px;color:var(--accent);margin-left:auto}

.linkcard{display:flex;flex-direction:column;gap:10px;max-width:640px}
.linkrow{display:flex;gap:8px;flex-wrap:wrap}
.linkrow input{flex:1 1 260px}
.quick{display:grid;gap:8px;grid-template-columns:repeat(auto-fill,minmax(min(100%,220px),1fr))}
.quick a{display:block;padding:9px 11px;border:1px solid var(--line);border-radius:3px;background:var(--bg);text-decoration:none;color:var(--fg);font-size:13px}
.quick a:hover{border-color:var(--accent)}
.quick a small{display:block;color:var(--muted);font-size:11px}
.note{color:var(--muted);font-size:12px}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>
</head>
<body>
<header>
  <div class="hrow">
    <div class="brand"><h1>Metcon</h1><span class="sub">45 WS daily weather &amp; ops brief</span></div>
    <div class="clock"><span><b>Z</b><span id="clkZ">--:--</span></span><span><b>ET</b><span id="clkL">--:--</span></span></div>
    <div class="hbtns">
      <button class="btn" id="btnTheme" type="button" aria-pressed="false" title="Switch light / dark">Light</button>
      <button class="btn" id="btnWall" type="button" aria-pressed="false" title="Wall mode: full-screen layout for the briefing screen">Wall</button>
      <button class="btn primary" id="refreshAll" type="button">Refresh all</button>
    </div>
  </div>
  <nav class="tabs" role="tablist" aria-label="Metcon briefing items" id="tabs"></nav>
</header>

<div class="wallbar" id="wallBar" aria-label="Wall mode controls">
  <span class="wbclock"><b>Z</b><span id="wbZ">--:--:--</span></span>
  <span class="wbclock"><b>ET</b><span id="wbL">--:--</span></span>
  <button type="button" class="btn sm" id="wbPrev" aria-label="Previous tab">&#9664;</button>
  <span class="wbtab" id="wbTab"></span>
  <button type="button" class="btn sm" id="wbNext" aria-label="Next tab">&#9654;</button>
  <label class="wbcyc"><input type="checkbox" id="wbCycle"> Rotate <select id="wbSecs"><option value="30">30 s</option><option value="60" selected>60 s</option><option value="120">2 min</option></select></label>
  <button type="button" class="btn sm" id="wbTheme">Light</button>
  <button type="button" class="btn sm" id="wbExit">Exit wall mode</button>
</div>
<main>
<!-- 1 Launch schedule -->
<div class="view" id="v-launch" role="tabpanel" hidden>
  <div class="vh"><h2>Launch Schedule</h2><span class="meta" id="llMeta"></span>
    <div class="act"><button class="btn sm" type="button" id="llRefresh">Refresh</button></div></div>
  <div id="nextLaunch"></div>
  <section class="panel">
    <div class="ph"><h3>Upcoming — CCSFS &amp; KSC</h3><span class="src">Launch Library 2 + local entries</span></div>
    <div class="tablewrap"><table>
      <thead><tr><th>NET (Z)</th><th>NET (ET)</th><th>Vehicle</th><th>Mission</th><th>Pad</th><th>Window</th><th>Status</th><th></th></tr></thead>
      <tbody id="llBody"><tr><td colspan="8" class="empty">Loading launches…</td></tr></tbody>
    </table></div>
  </section>
  <section class="panel">
    <div class="ph"><h3>Add an operation</h3><span class="meta">For ops not in the public feed (static fires, hazardous ops, range support). Saved in this browser.</span></div>
    <form class="add pb" id="addForm">
      <label>NET (local ET)<input type="datetime-local" id="fNet" required></label>
      <label>Vehicle / op<input type="text" id="fVeh" placeholder="Falcon 9" required></label>
      <label>Mission<input type="text" id="fMis" placeholder="Starlink 12-4"></label>
      <label>Pad<input type="text" id="fPad" placeholder="SLC-40"></label>
      <label>Window / notes<input type="text" id="fNote" placeholder="4 hr window"></label>
      <button class="btn primary" type="submit">Add</button>
    </form>
  </section>
</div>

<!-- 2 Past 24 h -->
<div class="view" id="v-obs" role="tabpanel" hidden>
  <div class="vh"><h2>Past 24 Hours</h2><span class="meta" id="obsMeta"></span>
    <div class="act"><button class="btn sm" type="button" id="obsRefresh">Refresh</button></div></div>
  <div class="sumrow" id="obsSummary"></div>
  <div class="stations" id="stations"></div>
  <p class="note">Precip is the sum of hourly METAR precip groups; stations without a precip sensor show "—". Lightning is auto-flagged from TS/LTG in the METARs. Set it from CGLSS or the lightning network with the selector, which overrides the auto flag for this briefing.</p>
</div>

<!-- 3 Impacts -->
<div class="view" id="v-impacts" role="tabpanel" hidden>
  <div class="vh"><h2>Impacts</h2><span class="meta" id="impMeta"></span>
    <div class="act"><button class="btn sm" type="button" id="impClear">Clear</button></div></div>
  <div class="impconfirm" id="impConfirm" hidden>Clear today's notes? <button class="btn sm" type="button" id="impYes">Clear notes</button><button class="btn sm" type="button" id="impNo">Keep</button></div>
  <section class="panel imp"><textarea id="impText" spellcheck="true" aria-label="Big-picture notes for the brief"
    placeholder="Big picture for today's brief: the pattern, what drives our weather, and the impacts to ops (lightning, winds, ceilings, launches)…"></textarea></section>
</div>

<!-- 4 Model analysis quad -->
<div class="view" id="v-analysis" role="tabpanel" hidden>
  <div class="vh"><h2>Model Analysis — Sfc to 500 mb</h2><span class="meta">SPC RAP-based mesoanalysis, current hour</span>
    <div class="act ctrl">
      <label>Sector <select id="mesoSector"><option value="18">Southeast (s18)</option><option value="19">CONUS (s19)</option></select></label>
      <button class="btn sm" type="button" id="quadRefresh">Refresh</button>
      <a class="btn sm" href="https://www.spc.noaa.gov/exper/mesoanalysis/" target="_blank" rel="noopener">SPC mesoanalysis</a></div></div>
  <section class="panel"><div class="quad" id="quad"></div></section>
  <p class="note">For forecast hours, use <a href="https://mag.ncep.noaa.gov/" target="_blank" rel="noopener">NCEP MAG</a> (GFS/NAM/RAP 4-panel products).</p>
</div>

<!-- 5 Skew-T -->
<div class="view" id="v-skewt" role="tabpanel" hidden>
  <div class="vh"><h2>Skew-T</h2><span class="meta" id="skewMeta"></span>
    <div class="act ctrl">
      <label>Site <select id="skewSite">
        <option value="XMR">XMR — Cape Canaveral</option><option value="TBW">TBW — Tampa Bay</option>
        <option value="JAX">JAX — Jacksonville</option><option value="MFL">MFL — Miami</option></select></label>
      <label>Cycle <select id="skewCycle"></select></label>
      <a class="btn sm" id="skewOpen" target="_blank" rel="noopener" href="https://www.spc.noaa.gov/exper/soundings/">SPC soundings</a></div></div>
  <section class="panel imgcell" style="max-width:900px">
    <div class="imgbox" id="skewBox"></div>
  </section>
  <p class="note">The XMR raob is not always in the SPC index; when it's missing, use TBW/JAX or the <a id="uwyoLink" href="https://weather.uwyo.edu/upperair/sounding.html" target="_blank" rel="noopener">UWyo 74794 sounding</a>.</p>
</div>

<!-- 6 Prog charts -->
<div class="view" id="v-guidance" role="tabpanel" hidden>
  <div class="vh"><h2>Prog Charts</h2><span class="meta" id="pgMeta">WPC surface progs via AWC</span>
    <div class="act ctrl">
